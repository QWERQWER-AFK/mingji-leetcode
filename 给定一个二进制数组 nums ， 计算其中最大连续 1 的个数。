class Solution {
    public int findMaxConsecutiveOnes(int[] nums) {
        int max=0;
        int count=0;
        for(int i=0;i<nums.length;i++){
            if(nums[i]==1){
                count++;
            
            max=Math.max(max,count);
            }
            else{count=0;
        }
        }
        return max;
    }

}
class Solution:
    def findMaxConsecutiveOnes(self, nums: List[int]) -> int:
        cur = 0
        maximum = 0
        for num in nums:
            cur = (cur+num)*num
            if cur > maximum:
                maximum = cur 
        return maximum
